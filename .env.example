# ==============================================================================
# RESEND EMAIL DISPATCH CONFIGURATION (FOR CONTACT FORM)
# ==============================================================================

# [REQUIRED] Your API key from Resend (https://resend.com/api-keys)
# Starts with "re_..."
RESEND_API_KEY=re_your_api_key_here

# [OPTIONAL] The email address that receives contact form submissions
# Defaults to abhinay.musku.reddy@gmail.com if not specified
CONTACT_TO_EMAIL=abhinay.musku.reddy@gmail.com

# [OPTIONAL] The sender address shown in emails
# - If you don't have a verified domain on Resend:
#   Use the default test address: "Portfolio Contact <onboarding@resend.dev>"
#   (Note: Resend free tier delivers onboarding@resend.dev emails ONLY to the
#   email address you signed up to Resend with).
# - If you verified your custom domain in Resend:
#   e.g. "Abhinay Musku <contact@abhinaymusku.dev>"
RESEND_FROM_EMAIL=Portfolio Contact <onboarding@resend.dev>

